# ─────────────────────────────────────────────────────────────────────────────
# Registrar Desk — FRONTEND environment (BUILD_SPEC §8.2)
# Copy to frontend/.env.local. Every value here is PUBLIC: it is baked into the
# browser bundle. Never put a secret (client secret, DB URI, etc.) in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Backend /api base URL. Required for a production build (the build fails without it); on Vercel set
# it under Project → Settings → Environment Variables, e.g. https://<web-app-name>.azurewebsites.net/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4848/api

# Socket.IO server URL (the backend's origin). Required for a production build, e.g.
# https://<web-app-name>.azurewebsites.net
NEXT_PUBLIC_SOCKET_URL=http://localhost:4848

# [INPUT REQUIRED — Phase 1] Client ID of the SPA app registration used for staff sign-in
# (can be the same Entra app as the backend's AZURE_CLIENT_ID). Public by design.
NEXT_PUBLIC_AZURE_CLIENT_ID=

# [INPUT REQUIRED — Phase 1] Entra tenant ID (same value as the backend's AZURE_TENANT_ID).
NEXT_PUBLIC_AZURE_TENANT_ID=

# Optional. Scope the web app requests for this API. Defaults to api://<NEXT_PUBLIC_AZURE_CLIENT_ID>/access_as_user;
# set it only if the Application ID URI under "Expose an API" is something else.
NEXT_PUBLIC_AZURE_API_SCOPE=
